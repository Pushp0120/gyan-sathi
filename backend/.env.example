# ─────────────────────────────────────────────────────────────
#  GyanSathi backend — copy this file to `.env` and fill values
#        (cp .env.example .env)
#  NEVER commit the real .env file. It holds secrets.
# ─────────────────────────────────────────────────────────────

# PostgreSQL (Neon) connection string with ?sslmode=require
# Get it from https://console.neon.tech → your project → Connection Details
DATABASE_URL=postgresql://USER:PASSWORD@HOST/gyansathi?sslmode=require

# Secret used to sign login tokens — any long random string
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated admin email list (these users get admin panel access)
ADMIN_EMAILS=admin@gyansathi.in

# NVIDIA API key for the AI chat / quiz generation
# Get one at https://build.nvidia.com (free tier available)
NVIDIA_API_KEY=

# ── Payment mode ─────────────────────────────────────────────
# upi_qr = show UPI QR + UTR verification flow (default)
# free   = mark all users PRO without payment
PAYMENT_MODE=upi_qr
UPI_PAYMENT_WINDOW_MIN=2

# ── Email (Brevo SMTP) — used for OTP / forgot-password mails ──
# Create a free account at https://www.brevo.com and generate SMTP keys
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=
MAIL_FROM=gyansathi@example.com
