# ================= Gyan Sathi — Environment Configuration =================
# Copy to .env and fill values. NEVER commit the real .env file.

# ---------- Database (PostgreSQL via Supabase) ----------
# Session pooler URL from Supabase → Project Settings → Database
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ---------- Supabase ----------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# Comma separated emails that get the admin role on seed
ADMIN_EMAILS=admin@gyansathi.in

# ---------- Redis (optional; falls back to in-memory cache) ----------
REDIS_URL=redis://localhost:6379/0

# ---------- AI Provider (NVIDIA NIM — OpenAI compatible) ----------
AI_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Efficient model for normal questions; supports chat_template_kwargs.thinking=false
AI_MODEL=nvidia/nemotron-3-super-120b-a12b
# More capable model for difficult/complex questions
AI_MODEL_ADVANCED=nvidia/nemotron-3-super-120b-a12b
# Embedding model for RAG (vector column size must match: 2048)
AI_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b
AI_EMBEDDING_DIM=2048

# ---------- App / Security ----------
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# ---------- Uploads ----------
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE=10485760
ALLOWED_UPLOAD_TYPES=pdf,png,jpg,jpeg,txt,md,docx

# ---------- Plans (DB is source of truth; these seed the plans table) ----------
FREE_UPLOAD_LIMIT=10
PREMIUM_UPLOAD_LIMIT=500
PREMIUM_PRICE_INR=10
PREMIUM_DURATION_DAYS=365

# ---------- Payments (Razorpay) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# sandbox = test subscription flow without real payment
PAYMENT_MODE=sandbox

# ---------- Misc ----------
ENVIRONMENT=development
LOG_LEVEL=INFO

# ---------- Direct SMTP email OTP (no Supabase needed) ----------
# Brevo: smtp-relay.brevo.com:587 (300 free/day) | Gmail: smtp.gmail.com:465 (app password)
# Resend: smtp.resend.com:465 | Leave empty = dev mode (OTP 000000)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Gyan Sathi
OTP_EXPIRE_MINUTES=5
OTP_MAX_ATTEMPTS=5
